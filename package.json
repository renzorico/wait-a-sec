{
  "name": "wait-a-sec",
  "version": "0.1.0",
  "description": "Browser extension that adds intentional friction before opening distracting websites",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-web-extension": "^4.1.1",
    "archiver": "^6.0.1"
  }
}
